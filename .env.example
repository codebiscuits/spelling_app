# Copy this to .env and fill in your values

# Generate a random secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Admin credentials
ADMIN_USERNAME=admin
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$...

# Set to false for local development (no HTTPS)
HTTPS_ONLY=false

# No credentials needed — TTS uses gTTS (no API key required)

# Optional: override paths (set automatically by fly.toml on Fly.io)
# DB_PATH=spelling.db
# AUDIO_DIR=static/audio
